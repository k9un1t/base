#!/usr/bin/env python3
"""dao-chargen — merge Dragon Age: Origins character-creator mods on Linux.

Native replacement for the Windows "CharGenMorph Compiler". The character
creator reads ONE file, chargenmorphcfg.xml, but every hair/face/skin mod ships
its own copy. This tool merges them all into a single file at the top of the
override folder.

    dao-chargen merge [--dry-run]   merge everything found in the override folder
    dao-chargen check               only report what a merge would do
    dao-chargen restore             undo: put the mods' own files back
    dao-chargen path                print the override folder it uses

What it reads (anywhere under override/, case-insensitive):
  chargenmorphcfg.xml          a mod's full copy (renamed to .orig after merging,
  chargenmorphcfg.xml.orig     so the game only ever sees the merged one)
  chargenmorphcfg-add.xml      a partial file: just the entries a mod adds,
                               in the same layout (replaces "edit it by hand")

Entries are matched by name ignoring case. The first file's order is kept and
new entries are appended. If two mods give the same entry different attributes
(e.g. cut="0" vs cut="1"), the first one wins and the clash is reported.
"""
import argparse
import os
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

STEAM_APPID = "47810"
PREFIX_DOCS = "pfx/drive_c/users/steamuser/Documents/BioWare/Dragon Age/packages/core/override"
OUT_NAME = "chargenmorphcfg.xml"
MARKER = "generated by dao-chargen"
FULL_RE = re.compile(r"^chargenmorphcfg\.xml(\.orig)?$", re.I)
ADD_RE = re.compile(r"^chargenmorphcfg-add\.xml$", re.I)
ASSET_EXTS = (".mmh", ".mop", ".dds", ".tnt", ".mao", ".tga")


def default_override():
    roots = [Path.home() / ".local/share/Steam", Path.home() / ".steam/steam"]
    vdf = Path.home() / ".local/share/Steam/steamapps/libraryfolders.vdf"
    if vdf.exists():
        roots += [Path(p) for p in re.findall(r'"path"\s+"([^"]+)"', vdf.read_text(errors="replace"))]
    for r in roots:
        p = r / "steamapps/compatdata" / STEAM_APPID / PREFIX_DOCS
        if p.parent.exists():          # packages/core exists = game was started once
            return p
    return None


def is_generated(path):
    try:
        return MARKER in path.read_text(encoding="utf-8-sig", errors="replace")[:400]
    except OSError:
        return False


def find_sources(override):
    full, add = [], []
    for p in override.rglob("*"):
        if not p.is_file():
            continue
        if p.parent == override and p.name.lower() == OUT_NAME:
            continue                    # our own output (or a hand-placed one, handled below)
        if FULL_RE.match(p.name):
            full.append(p)
        elif ADD_RE.match(p.name):
            add.append(p)
    key = lambda p: str(p.relative_to(override)).lower()
    return sorted(full, key=key), sorted(add, key=key)


def groups_of(root):
    """Yield (section, group_or_None, [resource elements]) in file order."""
    for sec in root:
        kids = list(sec)
        if kids and all(k.tag == "resource" for k in kids):
            yield sec.tag, None, kids
        elif not kids:
            yield sec.tag, None, []
        else:
            for g in kids:
                yield sec.tag, g.tag, [r for r in g if r.tag == "resource"]


def merge(files, override):
    sections = {}       # sec -> {group -> {lname: (name, attrs, src)}}  (dicts keep order)
    clashes, per_file_added, names_by_file = [], {}, {}
    for f in files:
        rel = str(f.relative_to(override))
        try:
            root = ET.parse(f).getroot()
        except ET.ParseError as e:
            sys.exit(f"dao-chargen: can't read {rel}: {e}\n  (fix or remove that file, then run again)")
        if root.tag != "morph_config":
            print(f"  skipped {rel}: not a chargen file (root <{root.tag}>)")
            continue
        added, seen = 0, set()
        for sec, grp, items in groups_of(root):
            bucket = sections.setdefault(sec, {}).setdefault(grp, {})
            for r in items:
                name = r.get("name")
                if name is None:
                    continue
                ln = name.lower()       # "" is real: it's the "None" choice (no beard, no makeup)
                seen.add((sec, grp, ln))
                if ln in bucket:
                    old_name, old_attrs, old_src = bucket[ln]
                    if {k: v for k, v in r.attrib.items()} != old_attrs:
                        clashes.append((sec, grp, name, old_attrs, old_src, dict(r.attrib), rel))
                else:
                    bucket[ln] = (name, dict(r.attrib), rel)
                    added += 1
        per_file_added[rel] = added
        names_by_file[rel] = seen
    return sections, clashes, per_file_added, names_by_file


def index_assets(override):
    names = set()
    for p in override.rglob("*"):
        if p.is_file():
            n = p.name.lower()
            names.add(n)
            names.add(os.path.splitext(n)[0])
    return names


def missing_assets(sections, base, assets):
    """Entries a mod added (not in every full file = not vanilla) with no file behind them."""
    out = []
    for sec, groups in sections.items():
        if sec.endswith("_colors"):
            continue                    # tints usually live in the game's own archives
        for grp, entries in groups.items():
            for ln, (name, _, src) in entries.items():
                if not ln or (sec, grp, ln) in base:
                    continue
                if ln in assets or any(ln + e in assets for e in ASSET_EXTS):
                    continue
                out.append((sec, grp, name, src))
    return out


def render(sections, sources):
    ind = "    "
    lines = ['<?xml version="1.0" encoding="utf-8"?>',
             f"<!-- {MARKER}: do not edit, run 'dao-chargen merge' after adding mods.",
             "     Sources:"]
    lines += [f"       {s}" for s in sources] + ["-->", "<morph_config>"]

    def res(name, attrs):
        a = " ".join(f'{k}="{ET._escape_attrib(v)}"' for k, v in
                     sorted(attrs.items(), key=lambda kv: kv[0] != "name"))
        return f"<resource {a}/>"

    for sec, groups in sections.items():
        lines.append(f"{ind}<{sec}>")
        for grp, entries in groups.items():
            if grp is None:
                lines += [f"{ind*2}{res(n, a)}" for n, a, _ in entries.values()]
            else:
                lines.append(f"{ind*2}<{grp}>")
                lines += [f"{ind*3}{res(n, a)}" for n, a, _ in entries.values()]
                lines.append(f"{ind*2}</{grp}>")
        lines.append(f"{ind}</{sec}>")
    lines.append("</morph_config>")
    return "\r\n".join(lines) + "\r\n"        # CRLF like the game's own files


def where(sec, grp):
    return f"{sec}/{grp}" if grp else sec


def cmd_merge(override, dry_run):
    out = override / OUT_NAME
    full, add = find_sources(override)
    hand_placed = out.exists() and not is_generated(out)
    if hand_placed:
        full.insert(0, out)             # someone's own merged file: use it as the base
    if not full and not add:
        print(f"No chargenmorphcfg files under {override} — nothing to merge.")
        return 0
    files = full + add
    sections, clashes, added, names_by_file = merge(files, override)

    full_rels = [str(f.relative_to(override)) for f in full]
    base = set.intersection(*(names_by_file[r] for r in full_rels if r in names_by_file)) if len(full_rels) > 1 else set()
    if len(full_rels) == 1:
        base = names_by_file.get(full_rels[0], set())

    print(f"Override: {override}\n")
    print("Merged files (entries each one added):")
    for f in files:
        rel = str(f.relative_to(override))
        print(f"  {added.get(rel, 0):4d}  {rel}")
    total = sum(len(e) for g in sections.values() for e in g.values())
    print(f"\n  = {total} entries in the merged file")

    if clashes:
        print("\nSame entry, different settings (first one kept):")
        for sec, grp, name, a1, s1, a2, s2 in clashes:
            diff = ", ".join(f"{k}: {a1.get(k)!r} vs {a2.get(k)!r}" for k in sorted(set(a1) | set(a2)) if a1.get(k) != a2.get(k))
            print(f"  {where(sec, grp)}  {name}  ({diff})\n      kept  {s1}\n      over  {s2}")

    miss = missing_assets(sections, base, index_assets(override))
    if miss:
        print("\nAdded entries with no matching file in override (won't show up in-game):")
        for sec, grp, name, src in miss:
            print(f"  {where(sec, grp)}  {name}   <- {src}")

    if dry_run:
        print("\nDry run: nothing written.")
        return 0

    if hand_placed:
        bak = out.with_name(OUT_NAME + ".before-dao-chargen")
        out.rename(bak)
        print(f"\nYour existing {OUT_NAME} was saved as {bak.name}")
    renamed = 0
    for f in full:
        if f.name.lower() == OUT_NAME and f.parent != override:
            f.rename(f.with_name(f.name + ".orig"))
            renamed += 1
    tmp = out.with_name(OUT_NAME + ".tmp")
    src_names = [OUT_NAME + ".before-dao-chargen" if f == out else
                 re.sub(r"\.orig$", "", str(f.relative_to(override))) for f in files]
    tmp.write_bytes(render(sections, src_names).encode("utf-8"))
    tmp.replace(out)
    print(f"\nWrote {out}")
    if renamed:
        print(f"Renamed {renamed} mod copies to chargenmorphcfg.xml.orig (the game must only see one).")
    return 0


def cmd_restore(override):
    n = 0
    for p in override.rglob("chargenmorphcfg.xml.orig"):
        target = p.with_name(OUT_NAME)
        if not target.exists():
            p.rename(target)
            n += 1
    out = override / OUT_NAME
    if out.exists() and is_generated(out):
        out.unlink()
        print(f"Removed merged {OUT_NAME}")
    bak = override / (OUT_NAME + ".before-dao-chargen")
    if bak.exists() and not out.exists():
        bak.rename(out)
        print(f"Put back your own {OUT_NAME}")
    print(f"Restored {n} mod copies.")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="dao-chargen", description=__doc__.split("\n\n")[0])
    ap.add_argument("command", choices=["merge", "check", "restore", "path"])
    ap.add_argument("--override", type=Path, help="override folder (default: the Steam Proton one)")
    ap.add_argument("--dry-run", action="store_true", help="merge: report only, write nothing")
    a = ap.parse_args()

    override = a.override or default_override()
    if override is None:
        sys.exit("dao-chargen: can't find the game's override folder.\n"
                 "  Start Dragon Age: Origins once through Steam (that creates it), or pass --override DIR.")
    if a.command == "path":
        print(override)
        return 0
    if not override.is_dir():
        if a.command == "merge" and not a.dry_run:
            sys.exit(f"dao-chargen: {override} doesn't exist yet — copy your mods into it first.")
        sys.exit(f"dao-chargen: {override} doesn't exist.")
    if a.command == "restore":
        return cmd_restore(override)
    return cmd_merge(override, dry_run=a.dry_run or a.command == "check")


if __name__ == "__main__":
    sys.exit(main())
