#!/usr/bin/env python3
"""
kuromi-wallpaper: draw Kuromi Soft wallpapers (original shapes in the Soft palette).

  kuromi-wallpaper [WIDTH HEIGHT]     writes haze / sparkle / pattern PNGs to
                                       ~/.local/share/backgrounds/ (default 1920x1080)

Styles:
  haze     diagonal lilac-to-orchid gradient with large soft glows
  sparkle  the same gradient with scattered four-point sparkles and tiny hearts
  pattern  a gentle repeating pattern of little skulls, hearts and stars
Brightest highlights are light lilac, never white. Same output every run (fixed seed).
"""
import math
import random
import sys
from pathlib import Path

from PIL import Image, ImageDraw, ImageEnhance, ImageFilter

# Kuromi Soft palette (see ~/CLAUDE.md)
LILAC = (184, 157, 200)      # #b89dc8 terminal background
ORCHID = (182, 157, 215)     # #b69dd7 window background
HEADER = (169, 139, 208)     # #a98bd0 panel / title bars
DEEP = (126, 84, 182)        # #7e54b6 Whisker border
PURPLE = (123, 63, 160)      # #7b3fa0 accent
PERI = (140, 132, 214)       # soft periwinkle
PINK = (197, 143, 208)       # pink-orchid
HILITE = (227, 213, 240)     # lightest lilac (used instead of white)

OUT = Path.home() / ".local/share/backgrounds"


def lerp(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def gradient(w, h, top_left, bottom_right):
    """Diagonal gradient, drawn small and scaled up so it stays smooth and fast."""
    sw, sh = 64, 36
    small = Image.new("RGB", (sw, sh))
    px = small.load()
    for y in range(sh):
        for x in range(sw):
            t = (x / (sw - 1) * 0.6 + y / (sh - 1) * 0.4)
            px[x, y] = lerp(top_left, bottom_right, t)
    return small.resize((w, h), Image.BICUBIC)


def glow_layer(w, h, blobs, blur):
    layer = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    for cx, cy, r, col, alpha in blobs:
        d.ellipse((cx - r, cy - r, cx + r, cy + r), fill=col + (alpha,))
    return layer.filter(ImageFilter.GaussianBlur(blur))


def haze(w, h, rnd):
    img = gradient(w, h, HEADER, ORCHID).convert("RGBA")
    s = w / 1920
    blobs = [
        (w * 0.18, h * 0.25, 420 * s, PINK, 150),
        (w * 0.82, h * 0.72, 520 * s, PERI, 130),
        (w * 0.62, h * 0.18, 300 * s, HILITE, 110),
        (w * 0.35, h * 0.85, 360 * s, LILAC, 140),
        (w * 0.95, h * 0.10, 260 * s, PINK, 90),
    ]
    img.alpha_composite(glow_layer(w, h, blobs, 160 * s))
    # pink and periwinkle glows blend toward grey where they overlap; push colour back in
    return ImageEnhance.Color(img.convert("RGB")).enhance(1.35).convert("RGBA")


def sparkle_shape(d, cx, cy, r, col):
    """Four-point star: two thin diamonds crossed."""
    k = r * 0.22
    d.polygon([(cx, cy - r), (cx + k, cy), (cx, cy + r), (cx - k, cy)], fill=col)
    d.polygon([(cx - r, cy), (cx, cy - k), (cx + r, cy), (cx, cy + k)], fill=col)


def heart_shape(d, cx, cy, r, col):
    pts = []
    for i in range(48):
        t = math.pi * 2 * i / 48
        x = 16 * math.sin(t) ** 3
        y = -(13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t))
        pts.append((cx + x * r / 17, cy + y * r / 17))
    d.polygon(pts, fill=col)


def sparkle(w, h, rnd):
    img = haze(w, h, rnd)
    s = w / 1920
    layer = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    for _ in range(90):
        x, y = rnd.uniform(0, w), rnd.uniform(0, h)
        r = rnd.choice([5, 7, 9, 12, 16, 22]) * s
        col = rnd.choice([HILITE, HILITE, PINK, PERI])
        sparkle_shape(d, x, y, r, col + (rnd.randint(120, 220),))
    for _ in range(26):
        x, y = rnd.uniform(0, w), rnd.uniform(0, h)
        heart_shape(d, x, y, rnd.choice([6, 8, 10]) * s, rnd.choice([PURPLE, DEEP, PINK]) + (rnd.randint(110, 180),))
    glow = layer.filter(ImageFilter.GaussianBlur(3 * s))
    img.alpha_composite(glow)
    img.alpha_composite(layer)
    return img


def skull_shape(d, cx, cy, r, col, hole):
    d.ellipse((cx - r, cy - r, cx + r, cy + r * 0.8), fill=col)                    # cranium
    d.rounded_rectangle((cx - r * 0.55, cy + r * 0.45, cx + r * 0.55, cy + r * 1.05),
                        radius=r * 0.2, fill=col)                                    # jaw
    for ex in (-0.38, 0.38):
        d.ellipse((cx + ex * r - r * 0.24, cy - r * 0.12, cx + ex * r + r * 0.24, cy + r * 0.36), fill=hole)
    d.polygon([(cx, cy + r * 0.42), (cx - r * 0.1, cy + r * 0.6), (cx + r * 0.1, cy + r * 0.6)], fill=hole)
    for tx in (-0.25, 0, 0.25):                                                       # teeth gaps
        d.line((cx + tx * r, cy + r * 0.72, cx + tx * r, cy + r * 1.0), fill=hole, width=max(1, round(r * 0.07)))


def pattern(w, h, rnd):
    img = gradient(w, h, ORCHID, LILAC).convert("RGBA")
    s = w / 1920
    layer = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    step = 150 * s
    rows, cols = int(h / step) + 2, int(w / step) + 2
    motif_col = HEADER + (210,)
    hole = ORCHID + (255,)
    for j in range(rows):
        for i in range(cols):
            cx = i * step + (step / 2 if j % 2 else 0)
            cy = j * step * 0.9
            kind = (i + 2 * j) % 3
            if kind == 0:
                skull_shape(d, cx, cy, 20 * s, motif_col, hole)
            elif kind == 1:
                heart_shape(d, cx, cy, 16 * s, PINK + (190,))
            else:
                sparkle_shape(d, cx, cy, 18 * s, PERI + (200,))
    img.alpha_composite(layer)
    img.alpha_composite(glow_layer(w, h, [(w * 0.5, h * 0.5, 700 * s, HILITE, 70)], 260 * s))
    return ImageEnhance.Color(img.convert("RGB")).enhance(1.35).convert("RGBA")


def main():
    w, h = (int(sys.argv[1]), int(sys.argv[2])) if len(sys.argv) == 3 else (1920, 1080)
    if len(sys.argv) not in (1, 3):
        sys.exit(__doc__)
    OUT.mkdir(parents=True, exist_ok=True)
    for name, fn in (("haze", haze), ("sparkle", sparkle), ("pattern", pattern)):
        path = OUT / f"kuromi-soft-{name}.png"
        fn(w, h, random.Random(7)).convert("RGB").save(path, optimize=True)
        print(path)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
    else:
        main()
