#!/usr/bin/env bash
# kuromi-mode: switch between your dark Kuromi setup and "Kuromi Soft",
# a muted lavender light mode that's easier on astigmatism.
#
#   kuromi-mode soft   -> muted lavender light mode
#   kuromi-mode dark   -> back to exactly how you had it
#   kuromi-mode        -> says which mode you're in
#
# Tweak the soft colours in ~/.config/gtk-3.0/kuromi-soft.css (top 4 lines).

set -u
CONF="$HOME/.config"
MODE_FILE="$CONF/kuromi-mode"
SAVE="$CONF/kuromi-mode-dark.conf"
GTKDIR="$CONF/gtk-3.0"
GTKCSS="$GTKDIR/gtk.css"
SOFTCSS="$GTKDIR/kuromi-soft.css"
IMPORT="@import url(\"file://$SOFTCSS\");"
# GTK4 / libadwaita apps (Loupe...) ignore GTK3 themes: they follow color-scheme + gtk-4.0/gtk.css
GTK4CSS="$CONF/gtk-4.0/gtk.css"
GTK4IMPORT="@import url(\"file://$CONF/gtk-4.0/kuromi-soft.css\");"
color_scheme() {   # color_scheme -> prints it; color_scheme VALUE -> sets it
    if [ -z "${1:-}" ]; then gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'"
    else gsettings set org.gnome.desktop.interface color-scheme "$1" 2>/dev/null; fi
}

get()  { xfconf-query -c "$1" -p "$2" 2>/dev/null; }
put()  { xfconf-query -c "$1" -p "$2" -s "$4" 2>/dev/null || xfconf-query -c "$1" -p "$2" -n -t "$3" -s "$4"; }

term_keys="/color-background /color-foreground /color-cursor /color-selection /color-selection-background /color-bold /color-palette /background-mode /background-darkness"

# Colours stored as 4 numbers 0-1 (red, green, blue, opacity), written as "r,g,b,a"
PANEL_RGBA=/panels/panel-1/background-rgba
LABEL_BG=/desktop-icons/label-background-color
LABEL_FG=/desktop-icons/label-text-color
get_rgba() { xfconf-query -c "$1" -p "$2" 2>/dev/null | grep -E '^[0-9.]+$' | paste -sd, -; }
put_rgba() {   # put_rgba CHANNEL PROPERTY "r,g,b,a"
    local IFS=, args=() v
    for v in $3; do args+=(-t double -s "$v"); done
    [ "${#args[@]}" -eq 16 ] || { [ -n "$3" ] && echo "(colour '$3' for $2 isn't 4 numbers, leaving it alone)"; return 0; }
    xfconf-query -c "$1" -p "$2" "${args[@]}" 2>/dev/null \
        || xfconf-query -c "$1" -p "$2" -n -a "${args[@]}"
}

# Claude Code's theme lives in ~/.claude/settings.json ("dark-ansi", "light-ansi", ...)
CLAUDE_SETTINGS="$HOME/.claude/settings.json"
claude_theme() {   # claude_theme        -> prints current theme
                   # claude_theme NAME   -> sets it, keeping other settings
    python3 -I - "$CLAUDE_SETTINGS" "${1:-}" << 'EOF'
import json, os, sys
path, new = sys.argv[1], sys.argv[2]
try:
    with open(path) as f: data = json.load(f)
except (FileNotFoundError, ValueError):
    data = {}
if not new:
    print(data.get("theme", "")); sys.exit()
data["theme"] = new
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
with open(tmp, "w") as f: json.dump(data, f, indent=2); f.write("\n")
os.replace(tmp, path)
EOF
}

find_theme() {
    for t in "$@"; do
        for d in "$HOME/.themes" "$HOME/.local/share/themes" /usr/share/themes; do
            [ -d "$d/$t" ] && { echo "$t"; return 0; }
        done
    done
    return 1
}

icon_exists() {
    for d in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
        [ -d "$d/$1" ] && return 0
    done
    return 1
}

ensure_prompt_block() {
    grep -q ">>> kuromi-mode prompt >>>" "$HOME/.bashrc" 2>/dev/null && return
    cat >> "$HOME/.bashrc" << 'EOF'

# >>> kuromi-mode prompt >>>
if [ "$(cat "$HOME/.config/kuromi-mode" 2>/dev/null)" = soft ]; then
  PS1='\[\e[38;2;123;63;160m\]\u@\h\[\e[0m\]:\[\e[38;2;92;79;168m\]\w\[\e[0m\]\$ '
else
  PS1='\[\e[38;2;196;122;216m\]\u@\h\[\e[0m\]:\[\e[38;2;160;144;230m\]\w\[\e[0m\]\$ '
fi
# <<< kuromi-mode prompt <<<
EOF
}

write_soft_css() {
    [ -f "$SOFTCSS" ] && return   # keep your tweaks if you've edited it
    mkdir -p "$GTKDIR"
    cat > "$SOFTCSS" << 'EOF'
/* Kuromi Soft: muted lavender light mode. Tweak these 4 colours freely. */
@define-color soft_bg     #b69dd7;  /* window backgrounds */
@define-color soft_view   #c6b3e0;  /* lists, text areas, menus */
@define-color soft_header #a98bd0;  /* title bars, toolbars, panel */
@define-color soft_fg     #2a1d33;  /* text */

window.background, .background, dialog, #whiskermenu-window {
  background-color: @soft_bg;
}

.view, iconview, treeview.view, textview text, list, list row, .sidebar,
placessidebar, placessidebar list, scrolledwindow viewport, notebook > stack,
entry, spinbutton, menu, .menu, .context-menu, popover, popover.background,
tooltip.background {
  background-color: @soft_view;
}

headerbar, .titlebar, menubar, toolbar, notebook > header,
.xfce4-panel, .xfce4-panel.background {
  background-color: @soft_header;
}

label, .view, textview text, entry, menuitem, treeview.view {
  color: @soft_fg;
}

/* keep selected and highlighted things readable */
*:selected, row:selected label, treeview.view:selected,
button.suggested-action label, button.destructive-action label {
  color: #ffffff;
}

/* Whisker menu: one lilac surface with an orchid border and soft plum shadow */
@define-color whisker_lilac       #b69dd7;  /* menu background */
@define-color whisker_lilac_light #c6b3e0;  /* search box */
@define-color whisker_border      #7e54b6;  /* deeper orchid edge */

window#whiskermenu-window {
  background-color: @whisker_lilac;   /* the window can't be see-through, so no rounded corners */
}

window#whiskermenu-window > frame > border {
  background-color: @whisker_lilac;
  border: 2px solid @whisker_border;
  border-radius: 0;
  margin: 0;
  box-shadow: 0 3px 6px -1px alpha(#3d2956, 0.35),
              0 6px 14px 0 alpha(#3d2956, 0.22),
              inset 0 1px alpha(#d7c9e9, 0.6);
}

window#whiskermenu-window scrolledwindow.frame,
window#whiskermenu-window scrolledwindow.frame treeview.view,
window#whiskermenu-window scrolledwindow.frame viewport,
window#whiskermenu-window box.categories,
window#whiskermenu-window .view,
window#whiskermenu-window list,
window#whiskermenu-window list row {
  background-color: transparent;
  border: none;
}

window#whiskermenu-window entry.search,
window#whiskermenu-window entry.search:focus {
  background-color: @whisker_lilac_light;
}

/* Desktop icon labels sit on an orchid chip with dark text: no shadow needed (it smudges dark text) */
XfdesktopIconView.view {
  text-shadow: none;
}
EOF
}

case "${1:-}" in
soft)
    light=$(find_theme Orchis-Purple-Light Orchis-Purple) || {
        echo "Orchis light isn't installed yet. Run:"
        echo "  cd ~/Downloads/Orchis-theme && ./install.sh -t purple -c light"
        exit 1; }
    if [ "$(cat "$MODE_FILE" 2>/dev/null)" != soft ]; then
        {   # remember your dark setup so 'dark' restores it exactly
            echo "theme=$(get xsettings /Net/ThemeName)"
            echo "wm=$(get xfwm4 /general/theme)"
            echo "icons=$(get xsettings /Net/IconThemeName)"
            for k in $term_keys; do echo "term$k=$(get xfce4-terminal "$k")"; done
            echo "claude=$(claude_theme)"
            echo "panel=$(get_rgba xfce4-panel "$PANEL_RGBA")"
            echo "label_bg=$(get_rgba xfce4-desktop "$LABEL_BG")"
            echo "label_fg=$(get_rgba xfce4-desktop "$LABEL_FG")"
            echo "label_bg_on=$(get xfce4-desktop /desktop-icons/use-custom-label-background-color)"
            echo "label_fg_on=$(get xfce4-desktop /desktop-icons/use-custom-label-text-color)"
            echo "colorscheme=$(color_scheme)"
        } > "$SAVE"
    fi
    write_soft_css
    touch "$GTKCSS"
    grep -qF "kuromi-soft.css" "$GTKCSS" || sed -i "1i $IMPORT" "$GTKCSS"
    [ -s "$GTKCSS" ] || echo "$IMPORT" > "$GTKCSS"
    put xsettings /Net/ThemeName string "$light"
    # window frames: recoloured copy of Orchis in ~/.themes/Kuromi-Soft, if it exists
    put xfwm4 /general/theme string "$(find_theme Kuromi-Soft || echo "$light")"
    if icon_exists Kuromi-Colloid; then         # Colloid in one Kuromi purple
        put xsettings /Net/IconThemeName string Kuromi-Colloid
    elif icon_exists Kuromi-Tela-Soft; then     # darker Kuromi-Tela badges for the light theme
        put xsettings /Net/IconThemeName string Kuromi-Tela-Soft
    elif icon_exists Kuromi-Candy-Light; then
        put xsettings /Net/IconThemeName string Kuromi-Candy-Light
    else
        echo "(no Soft icon theme found, keeping your current icons)"
    fi
    put xfce4-terminal /color-use-theme bool false
    put xfce4-terminal /color-background string '#b89dc8'
    put xfce4-terminal /color-foreground string '#2a1d33'
    put xfce4-terminal /color-cursor string '#7b3fa0'
    put xfce4-terminal /color-selection string '#ffffff'
    put xfce4-terminal /color-selection-background string '#7b3fa0'
    put xfce4-terminal /color-bold string '#1e1424'
    # blues are dusky periwinkle; "white" slots are light so highlights stay readable
    put xfce4-terminal /color-palette string '#2a1d33;#a8305f;#3c6e4a;#7d5f1a;#5c4fa8;#7b3fa0;#2c6670;#c4b8d0;#4a3757;#c0447a;#4c8059;#94721f;#6a5fb8;#9350b8;#367a85;#cfc5d9'
    put xfce4-terminal /background-mode string TERMINAL_BACKGROUND_TRANSPARENT
    put xfce4-terminal /background-darkness double 0.92   # 92% opaque
    put_rgba xfce4-panel "$PANEL_RGBA" "0.662,0.546,0.814,0.658"   # top panel: #a98bd0 at 66% opacity
    # desktop icon labels: orchid chip (#a98bd0, 85%) with dark plum text (#2a1d33)
    put_rgba xfce4-desktop "$LABEL_BG" "0.662,0.546,0.814,0.85"
    put_rgba xfce4-desktop "$LABEL_FG" "0.165,0.114,0.2,1.0"
    put xfce4-desktop /desktop-icons/use-custom-label-background-color bool true
    put xfce4-desktop /desktop-icons/use-custom-label-text-color bool true
    # notifications (volume bar etc.): Kuromi-Soft notify theme, used in both modes
    [ -d "$HOME/.themes/Kuromi-Soft/xfce-notify-4.0" ] && put xfce4-notifyd /theme string Kuromi-Soft
    # GTK4 / libadwaita apps: light scheme + the Soft palette (only if its CSS file exists)
    color_scheme prefer-light
    if [ -f "$CONF/gtk-4.0/kuromi-soft.css" ]; then
        touch "$GTK4CSS"
        grep -qF "gtk-4.0/kuromi-soft.css" "$GTK4CSS" || sed -i "1i $GTK4IMPORT" "$GTK4CSS"
        [ -s "$GTK4CSS" ] || echo "$GTK4IMPORT" > "$GTK4CSS"
    fi
    claude_theme light-ansi   # dark-ansi highlights are unreadable on the lavender background
    ensure_prompt_block
    echo soft > "$MODE_FILE"
    echo "Kuromi Soft is on 🌸 Open a new terminal for the matching prompt."
    echo "Some apps only fully switch after you reopen them."
    ;;
dark)
    theme="Orchis-Purple-Dark"; wm="Orchis-Purple-Dark"; icons="Kuromi-Candy"; claude="dark-ansi"
    panel="0.180,0.133,0.220,0.66"   # fallback: dark plum #2e2238 at 66% opacity
    label_bg=""; label_fg="1.0,1.0,1.0,1.0"; label_bg_on=false; label_fg_on=true   # fallback: xfdesktop chip, white text
    colorscheme=prefer-dark
    declare -A term
    # fallbacks for settings older saves don't have
    term[/background-mode]=TERMINAL_BACKGROUND_TRANSPARENT
    term[/background-darkness]=0.84
    if [ -f "$SAVE" ]; then
        while IFS='=' read -r k v; do
            case "$k" in
                theme) [ -n "$v" ] && theme="$v" ;;
                wm)    [ -n "$v" ] && wm="$v" ;;
                icons) [ -n "$v" ] && icons="$v" ;;
                claude) [ -n "$v" ] && [ "$v" != light-ansi ] && claude="$v" ;;
                panel)  [ -n "$v" ] && panel="$v" ;;
                label_bg)    [ -n "$v" ] && label_bg="$v" ;;
                label_fg)    [ -n "$v" ] && label_fg="$v" ;;
                label_bg_on) [ -n "$v" ] && label_bg_on="$v" ;;
                label_fg_on) [ -n "$v" ] && label_fg_on="$v" ;;
                colorscheme) [ -n "$v" ] && [ "$v" != prefer-light ] && colorscheme="$v" ;;
                term/*) [ -n "$v" ] && term["${k#term}"]="$v" ;;
            esac
        done < "$SAVE"
    fi
    [ -f "$GTKCSS" ] && sed -i '/kuromi-soft.css/d' "$GTKCSS"
    [ -f "$GTK4CSS" ] && sed -i '/gtk-4.0\/kuromi-soft.css/d' "$GTK4CSS"
    color_scheme "$colorscheme"
    put xsettings /Net/ThemeName string "$theme"
    put xfwm4 /general/theme string "$wm"
    put xsettings /Net/IconThemeName string "$icons"
    for k in $term_keys; do
        [ -n "${term[$k]:-}" ] && put xfce4-terminal "$k" string "${term[$k]}"
    done
    put_rgba xfce4-panel "$PANEL_RGBA" "$panel"
    put_rgba xfce4-desktop "$LABEL_BG" "$label_bg"
    put_rgba xfce4-desktop "$LABEL_FG" "$label_fg"
    put xfce4-desktop /desktop-icons/use-custom-label-background-color bool "$label_bg_on"
    put xfce4-desktop /desktop-icons/use-custom-label-text-color bool "$label_fg_on"
    claude_theme "$claude"
    ensure_prompt_block
    echo dark > "$MODE_FILE"
    echo "Back to dark Kuromi 🖤 Open a new terminal for the matching prompt."
    ;;
*)
    echo "Current mode: $(cat "$MODE_FILE" 2>/dev/null || echo dark)"
    echo "Usage: kuromi-mode soft | kuromi-mode dark"
    ;;
esac
