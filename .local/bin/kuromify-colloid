#!/usr/bin/env python3
"""
kuromify-colloid: build the Kuromi-Colloid icon theme (Colloid in one Kuromi purple,
tuned for the light Kuromi Soft theme).

  kuromify-colloid                 copy Colloid-Purple-Light -> Kuromi-Colloid and recolour it
  kuromify-colloid SOURCE NAME     recolour any installed icon theme into a new theme NAME

Needs the Colloid theme first (once):
  git clone https://github.com/vinceliuice/Colloid-icon-theme && Colloid-icon-theme/install.sh -t purple

Every colour (hex, rgb(), named colours like "gray") becomes a shade of one purple,
keeping how light/dark it was. currentColor is left alone so symbolic icons still
follow the GTK theme. Your source theme is NOT touched; re-running rebuilds NAME.
"""

import colorsys
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# ---- tweak these to taste -------------------------------------------------
HUE = 280          # 270 = bluer purple, 280 = Kuromi purple, 295 = pinker
SATURATION = 0.45  # 0 = grey, 1 = neon
DARKEST = 0.12     # lightness for the darkest bits (0-1)
LIGHTEST = 0.72    # lightness for the lightest bits (0-1); lower = darker icons
# ---------------------------------------------------------------------------

ICONS = Path.home() / ".local/share/icons"

NAMED = {"black": (0, 0, 0), "white": (255, 255, 255), "gray": (128, 128, 128), "grey": (128, 128, 128),
         "silver": (192, 192, 192), "darkgray": (169, 169, 169), "darkgrey": (169, 169, 169),
         "lightgray": (211, 211, 211), "lightgrey": (211, 211, 211), "dimgray": (105, 105, 105),
         "dimgrey": (105, 105, 105), "gainsboro": (220, 220, 220), "whitesmoke": (245, 245, 245),
         "red": (255, 0, 0), "green": (0, 128, 0), "lime": (0, 255, 0), "blue": (0, 0, 255),
         "yellow": (255, 255, 0), "orange": (255, 165, 0), "purple": (128, 0, 128), "magenta": (255, 0, 255),
         "fuchsia": (255, 0, 255), "cyan": (0, 255, 255), "aqua": (0, 255, 255), "teal": (0, 128, 128),
         "navy": (0, 0, 128), "maroon": (128, 0, 0), "olive": (128, 128, 0), "pink": (255, 192, 203),
         "brown": (165, 42, 42), "gold": (255, 215, 0)}

HEX = re.compile(r"#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?![0-9a-fA-F])")
RGB = re.compile(r"rgba?\(\s*(\d+(?:\.\d+)?)\s*,\s*(\d+(?:\.\d+)?)\s*,\s*(\d+(?:\.\d+)?)\s*(,\s*[\d.]+%?\s*)?\)")
NAME = re.compile(r"((?:fill|stroke|stop-color|flood-color|lighting-color|color)\s*[:=]\s*\"?)("
                  + "|".join(sorted(NAMED, key=len, reverse=True)) + r")\b", re.I)


def purple(r, g, b):
    # mix perceived luminance with the strongest channel so vivid colours don't go near-black
    level = 0.5 * (0.2126 * r + 0.7152 * g + 0.0722 * b) + 0.5 * max(r, g, b)
    return colorsys.hls_to_rgb(HUE / 360, DARKEST + level * (LIGHTEST - DARKEST), SATURATION)


def hexof(rgb):
    return "#%02x%02x%02x" % tuple(round(x * 255) for x in rgb)


def recolour(text):
    text = NAME.sub(lambda m: m.group(1) + hexof(purple(*(c / 255 for c in NAMED[m.group(2).lower()]))), text)

    def hx(m):
        v = m.group(1)
        v = "".join(c * 2 for c in v) if len(v) == 3 else v
        return hexof(purple(*(int(v[i:i + 2], 16) / 255 for i in (0, 2, 4))))

    def rg(m):
        n = ",".join(str(round(x * 255)) for x in purple(*(min(float(m.group(i)), 255) / 255 for i in (1, 2, 3))))
        return f"rgba({n}{m.group(4).rstrip()})" if m.group(4) else f"rgb({n})"

    return RGB.sub(rg, HEX.sub(hx, text))


def find_theme(name):
    for root in (ICONS, Path.home() / ".icons", Path("/usr/share/icons")):
        if (root / name / "index.theme").is_file():
            return root / name
    return None


def main():
    src_name, new_name = (sys.argv[1], sys.argv[2]) if len(sys.argv) == 3 else ("Colloid-Purple-Light", "Kuromi-Colloid")
    if len(sys.argv) not in (1, 3):
        sys.exit(__doc__)
    src = find_theme(src_name)
    if not src:
        sys.exit(f"Icon theme '{src_name}' isn't installed. See: kuromify-colloid --help")
    dst = ICONS / new_name
    if dst.resolve() == src.resolve():
        sys.exit("Source and new theme can't be the same folder.")

    print(f"Copying {src} -> {dst} ...")
    if dst.exists():
        shutil.rmtree(dst)
    shutil.copytree(src, dst, symlinks=True)

    n = changed = 0
    for dp, _, files in os.walk(dst):
        for f in files:
            p = os.path.join(dp, f)
            if not f.endswith(".svg") or os.path.islink(p):
                continue
            with open(p, encoding="utf-8", errors="surrogateescape") as fh:
                t = fh.read()
            o = recolour(t)
            n += 1
            if o != t:
                changed += 1
                with open(p, "w", encoding="utf-8", errors="surrogateescape") as fh:
                    fh.write(o)
    print(f"Recoloured {changed} of {n} icons.")

    index = dst / "index.theme"
    text = re.sub(r"(?m)^Name=.*$", f"Name={new_name}", index.read_text())
    text = re.sub(r"(?m)^Comment=.*$", f"Comment={src_name} recoloured to one Kuromi purple", text)
    index.write_text(text)

    (dst / "icon-theme.cache").unlink(missing_ok=True)
    subprocess.run(["gtk-update-icon-cache", "-f", "-q", str(dst)], check=False)
    print(f"Done. Pick '{new_name}' in Appearance > Icons, or run: kuromi-mode soft")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
    else:
        main()
